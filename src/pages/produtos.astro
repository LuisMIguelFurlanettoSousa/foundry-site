---
import { Image } from 'astro:assets';
import ArrowIcon from '../components/ArrowIcon.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import sticker02 from '../assets/stickers/sticker-02.png';

const produtos = [
  {
    numero: '01',
    nome: 'Site essencial',
    categoria: 'Presença digital',
    descricao: 'Uma página direta, já hospedada e pronta para apresentar o seu negócio com clareza.',
    entregas: ['Página que funciona bem no celular', 'Visual criado para a sua marca', 'Hospedagem inicial inclusa'],
  },
  {
    numero: '02',
    nome: 'Site com domínio próprio',
    categoria: 'Presença digital',
    descricao: 'Um site com endereço próprio, do jeito que passa confiança para quem procura você.',
    entregas: ['Domínio no nome da sua marca', 'Página que funciona bem no celular', 'Visual criado para a sua marca', 'Hospedagem inicial inclusa'],
  },
  {
    numero: '03',
    nome: 'Identidade completa',
    categoria: 'Marca',
    descricao: 'Marca, site e material de lançamento funcionando como um conjunto só.',
    entregas: ['Site com domínio próprio', 'Logo e identidade visual', 'Manual da marca', 'Três posts e três carrosséis para Instagram'],
  },
  {
    numero: '04',
    nome: 'Software sob medida',
    categoria: 'Produto digital',
    descricao: 'Sistemas feitos a partir do que o seu negócio precisa resolver no dia a dia.',
    entregas: ['Entendimento do que você precisa', 'Desenho da solução', 'Interface e programação', 'Escopo definido junto com você'],
  },
  {
    numero: '05',
    nome: 'Atendente automático',
    categoria: 'WhatsApp',
    descricao: 'Atendimento automático para quem recebe muita mensagem pelo WhatsApp.',
    entregas: ['Responde sobre serviços e produtos', 'Filtra os contatos que chegam', 'Conversas adaptadas ao seu negócio', 'Conectado ao número da empresa'],
  },
  {
    numero: '06',
    nome: 'Atendente avançado',
    categoria: 'Inteligência artificial',
    descricao: 'Um atendente que conduz conversas mais complexas e aprende com as informações da empresa.',
    entregas: ['Marca reuniões', 'Apresenta, vende e confirma pedidos', 'Consulta as informações da empresa', 'Fica melhor com o uso'],
  },
  {
    numero: '07',
    nome: 'Conteúdo mensal',
    categoria: 'Redes sociais',
    descricao: 'Uma rotina mensal para manter a marca aparecendo sem perder a cara dela.',
    entregas: ['Seis posts por mês', 'Três carrosséis por mês', 'Tudo no visual da sua marca', 'Assuntos planejados com antecedência'],
  },
];
---

<BaseLayout title="Produtos | Foundry" description="Sites, marcas, software e atendimento automático para o próximo passo do seu negócio.">
  <Header />
  <main id="conteudo">
    <section class="page-hero page-hero--products section-shell" aria-labelledby="titulo-produtos">
      <div class="page-hero__content">
        <p class="eyebrow">Escolha pelo problema, não pelo nome</p>
        <h1 id="titulo-produtos">Tudo que a gente <em>faz.</em></h1>
        <p>Sites, marcas, software e atendimento automático. A gente junta as peças certas para o momento do seu negócio.</p>
        <a class="text-link" href="#catalogo">Ver a lista <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <div class="catalog-section section-shell">
      <section id="catalogo" class="catalog section-pad" aria-labelledby="titulo-catalogo">
        <div class="catalog__heading">
          <div>
            <h2 id="titulo-catalogo">Cada problema pede<br /><em>uma solução certa.</em></h2>
          </div>
          <div>
            <p>Você não precisa chegar sabendo o nome do serviço. Conte onde o negócio está travando e a gente indica o que faz sentido.</p>
            <div class="catalog__badge">
              <Image src={sticker02} alt="Foguinho trabalhando no laptop" width={84} densities={[1, 2]} class="sticker sticker--laptop sticker--solto" loading="lazy" />
            </div>
          </div>
        </div>
        <div class="product-grid">
          {produtos.map((produto) => (
            <article class="product-card">
              <div class="product-card__meta"><span>{produto.numero}</span><span>{produto.categoria}</span></div>
              <h3>{produto.nome}</h3>
              <p>{produto.descricao}</p>
              <ul>{produto.entregas.map((entrega) => <li>{entrega}</li>)}</ul>
            </article>
          ))}
        </div>
      </section>
    </div>

    <section class="page-cta section-shell" aria-labelledby="titulo-cta-produtos">
      <h2 id="titulo-cta-produtos">Não achou o que precisa?<br /><em>A gente monta.</em></h2>
      <p>Site, marca, conteúdo e atendimento automático podem virar um pacote só, do tamanho que o seu negócio precisa.</p>
      <a class="button button--paper" href="/#contato">Contar o que preciso <ArrowIcon /></a>
    </section>
  </main>
  <Footer />
</BaseLayout>
