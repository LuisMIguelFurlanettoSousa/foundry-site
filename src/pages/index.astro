---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import ArrowIcon from '../components/ArrowIcon.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import antesDepois from '../assets/brand/antes-depois.jpeg';
import fundicao from '../assets/brand/hero-fundicao.png';
import mascote from '../assets/brand/mascote-creme.png';
import mockup from '../assets/brand/mockup-projeto.jpeg';
import fundicaoLimpa from '../assets/brand/fundicao-limpa-pexels.jpeg';
import sticker01 from '../assets/stickers/sticker-01.png';
import sticker02 from '../assets/stickers/sticker-02.png';
import sticker03 from '../assets/stickers/sticker-03.png';
import sticker04 from '../assets/stickers/sticker-04.png';
import sticker05 from '../assets/stickers/sticker-05.png';

const etapas = [
  { numero: '01', nome: 'Conversa', texto: 'A gente entende o seu negócio, quem é o seu cliente e o que você já tem pronto.' },
  { numero: '02', nome: 'Planejamento', texto: 'Definimos o que o site precisa dizer, em que ordem e para onde ele leva quem chega.' },
  { numero: '03', nome: 'Criação', texto: 'Design e programação andam juntos, testados no celular e no computador de verdade.' },
  { numero: '04', nome: 'No ar', texto: 'O site entra no ar pronto para receber visitas e gerar contato.' },
];

const perguntas = [
  ['Em quanto tempo fica pronto?', 'O prazo é de doze dias. Se algo mudar, você fica sabendo antes de precisar perguntar.'],
  ['Preciso ter tudo pronto?', 'Não. A gente começa com o que você tem e diz o que falta.'],
  ['Vocês refazem sites que já existem?', 'Sim. Melhorar o que já está no ar faz parte do trabalho.'],
  ['Posso perguntar o básico?', 'Pode perguntar o que quiser, inclusive o básico. Principalmente o básico.'],
];

const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';

// Hero em duas artes: a paisagem no desktop e, quando existir, uma arte em
// retrato para o celular (src/assets/brand/hero-fundicao-mobile.jpg, gerada a
// partir de docs/prompts-fundos-mobile.md). Sem o arquivo, o celular recebe
// a paisagem recortada por object-position.
const heroMobileModulos = import.meta.glob<{ default: ImageMetadata }>('../assets/brand/hero-fundicao-mobile.{jpg,jpeg,png,webp}', { eager: true });
const heroMobileOrigem = Object.values(heroMobileModulos)[0]?.default;
const heroDesktop = await getImage({ src: fundicao, widths: [960, 1400, 1700], sizes: '100vw', format: 'webp', quality: 82 });
const heroMobile = heroMobileOrigem
  ? await getImage({ src: heroMobileOrigem, widths: [480, 720, 1080], sizes: '100vw', format: 'webp', quality: 80 })
  : null;
---

<BaseLayout title="Foundry - Sites que explicam o seu negócio" description="Sites e landing pages feitos do começo ao fim, prontos em doze dias.">
  <div class="heat-progress" aria-hidden="true"><span data-progress></span></div>
  <Header />

  <main id="conteudo">
    <section id="inicio" class="hero section-shell" aria-labelledby="titulo-principal">
      <div class="hero__media" data-slot="slot-hero-fundicao">
        <picture>
          {heroMobile && <source media="(max-width: 900px)" srcset={heroMobile.srcSet.attribute} sizes="100vw" width={heroMobile.attributes.width} height={heroMobile.attributes.height} />}
          <img
            src={heroDesktop.src}
            srcset={heroDesktop.srcSet.attribute}
            sizes="100vw"
            width={heroDesktop.attributes.width}
            height={heroDesktop.attributes.height}
            alt="Metal incandescente sendo derramado em uma oficina"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <!-- Fora do .hero__media: por cima do véu, senão o preto do véu engole o brilho. -->
      <div class="hero__heat" aria-hidden="true"></div>

      <div class="hero__content">
        <div class="hero__top-meta">
          <p class="eyebrow">Sites e landing pages</p>
          <Image src={sticker01} alt="Foguinho, o mascote da Foundry, acenando" width={58} densities={[1, 2]} class="sticker sticker--wave" loading="eager" />
        </div>
        <h1 id="titulo-principal">Seu trabalho é bom. O site precisa <em>mostrar isso.</em></h1>
        <p class="hero__intro">A gente cria o site do seu negócio do começo ao fim: texto, design e programação. Você conta o que faz, a gente coloca no ar.</p>
        <div class="hero__actions">
          <a class="button button--fire" href="#contato">Quero meu site <ArrowIcon /></a>
          <a class="text-link" href="#processo">Ver como funciona <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero__note">Uma conversa direta, sem compromisso.</p>
      </div>
    </section>

    <div class="manifesto-section section-shell">
      <section class="manifesto section-pad" aria-labelledby="titulo-manifesto">
        <div class="manifesto__grid">
          <h2 id="titulo-manifesto" class="reveal">Um site que <span>explica</span><br />o seu negócio.</h2>
          <div>
            <p>Site bom não é o mais enfeitado. É o que faz a pessoa entender o que você vende, por que confiar em você e como falar com você. A gente corta o excesso e deixa isso claro.</p>
            <div class="manifesto__badge">
              <Image src={sticker04} alt="Foguinho segurando um martelo" width={92} densities={[1, 2]} class="sticker sticker--hammer sticker--solto" loading="lazy" />
            </div>
          </div>
        </div>
      </section>
    </div>

    <div class="process-section section-shell">
      <section id="processo" class="process section-pad" aria-labelledby="titulo-processo">
        <div class="process__heading">
          <h2 id="titulo-processo" class="reveal">Doze dias.<br />Quatro etapas.<br /><em>Nenhuma surpresa.</em></h2>
          <div class="process__heading-sticker">
            <Image src={sticker02} alt="Foguinho trabalhando no laptop" width={88} densities={[1, 2]} class="sticker sticker--laptop sticker--solto" loading="lazy" />
          </div>
        </div>
        <div>
          <ol class="process__list">
            {etapas.map((etapa) => (
              <li class="process__item reveal-item">
                <span class="process__number">{etapa.numero}</span>
                <div><h3>{etapa.nome}</h3><p>{etapa.texto}</p></div>
                <span class="process__spark" aria-hidden="true"></span>
              </li>
            ))}
          </ol>
          <p class="process__promise">Se o prazo mudar, você fica sabendo antes de perguntar.</p>
        </div>
      </section>
    </div>

    <div class="work-section section-shell">
      <section id="trabalho" class="work section-pad" aria-labelledby="titulo-trabalho">
        <div class="work__top">
          <div>
            <h2 id="titulo-trabalho" class="reveal">Site bonito chama atenção.<br /><em>Site bem feito traz cliente.</em></h2>
          </div>
          <div class="work__top-sticker">
            <Image src={sticker03} alt="Foguinho aprovando com o polegar" width={88} densities={[1, 2]} class="sticker sticker--thumb sticker--solto" loading="lazy" />
          </div>
        </div>
        <div class="work__grid">
          <article class="work-card work-card--wide reveal-item">
            <div class="work-card__media" data-slot="slot-trabalho-antes">
              <Image src={antesDepois} alt="Comparação de um site antes e depois de ser refeito" widths={[640, 960, 1400]} sizes="(min-width: 800px) 62vw, 100vw" loading="lazy" />
            </div>
            <div class="work-card__copy"><span>01 / Antes e depois</span><h3>Refeito do zero.</h3><p>Texto, ordem das informações e botões reorganizados para a pessoa entender rápido.</p></div>
          </article>
          <article class="work-card reveal-item">
            <div class="work-card__media" data-slot="slot-trabalho-mockup">
              <Image src={mockup} alt="Site da marca aplicado em telas e materiais impressos" widths={[520, 760]} sizes="(min-width: 800px) 38vw, 100vw" loading="lazy" />
            </div>
            <div class="work-card__copy"><span>02 / No celular</span><h3>Bom em qualquer tela.</h3><p>Funciona bem no celular, carrega rápido e é fácil de ler.</p></div>
          </article>
          <article class="work-card work-card--poster reveal-item">
            <div class="work-card__media" data-slot="slot-trabalho-poster">
              <Image src={fundicaoLimpa} alt="Profissional trabalhando com metal incandescente" widths={[520, 760]} sizes="(min-width: 800px) 38vw, 100vw" loading="lazy" />
            </div>
            <div class="work-card__copy"><span>03 / Contato</span><h3>Feito para gerar contato.</h3><p>Cada parte da página ajuda quem está lendo a dar o próximo passo.</p><small class="work-card__credit">Foto: Mehmet Turgut Kirkgoz / Pexels</small></div>
          </article>
          <aside class="work-quote reveal-item">
            <p>“Seu trabalho já é bom.<br />O site tem que <em>mostrar.</em>”</p>
            <div class="work-quote__footer">
              <span>Foundry</span>
            </div>
          </aside>
        </div>
      </section>
    </div>

    <div class="principles-section section-shell">
      <section class="principles section-pad" aria-labelledby="titulo-principios">
        <h2 id="titulo-principios" class="reveal">Trabalho sério.<br /><em>Conversa leve.</em></h2>
        <div class="principles__grid">
          <article><span>01</span><h3>Prazo claro.</h3><p>Doze dias de prazo. Se mudar alguma coisa, a gente avisa antes.</p></article>
          <article><span>02</span><h3>Direção.</h3><p>A gente recomenda um caminho em vez de jogar um monte de decisão em cima de você.</p></article>
          <article><span>03</span><h3>Cuidado.</h3><p>Seu site é tratado como se fosse nosso. E do nosso a gente cuida bastante.</p></article>
        </div>
      </section>
    </div>

    <div class="diagnostic-section section-shell">
      <section id="diagnostico" class="diagnostic section-pad" aria-labelledby="titulo-diagnostico" data-diagnostico>
        <div class="diagnostic__intro">
          <h2 id="titulo-diagnostico" class="reveal">O que o seu site precisa <em>resolver agora?</em></h2>
          <p>Escolha a frase mais parecida com a sua situação. A gente responde o que fazer primeiro, sem pedir o seu e-mail antes.</p>
        </div>

        <div class="diagnostic__panel">
          <div class="diagnostic__meter" aria-hidden="true">
            <span class="diagnostic__meter-label">Situação do seu site</span>
            <div class="diagnostic__crucible"><i data-diagnostico-nivel></i></div>
            <span class="diagnostic__meter-value" data-diagnostico-valor>00%</span>
          </div>

          <div class="diagnostic__content">
            <p class="diagnostic__question">Qual frase descreve melhor o seu momento?</p>
            <div class="diagnostic__options" role="group" aria-label="Situação atual do seu site">
              <button type="button" data-diagnostico-opcao data-nivel="38" data-titulo="Começar do zero." data-texto="Antes de pensar em páginas, a gente organiza o que o site precisa dizer, o caminho de quem chega e a ação que ele deve gerar."><span>01</span>Ainda não tenho site.</button>
              <button type="button" data-diagnostico-opcao data-nivel="68" data-titulo="Refazer o que já existe." data-texto="O primeiro passo é separar o que ainda serve do que só atrapalha. Depois, estrutura e visual ganham uma direção só."><span>02</span>Meu site não representa o negócio.</button>
              <button type="button" data-diagnostico-opcao data-nivel="92" data-titulo="Abrir caminho para o contato." data-texto="A base já existe. O trabalho se concentra na ordem das informações, nas provas e nos botões, para transformar visita em conversa."><span>03</span>Meu site não gera contato.</button>
            </div>

            <div class="diagnostic__result" aria-live="polite" data-diagnostico-resultado>
              <div class="diagnostic__result-header">
                <span>O que fazer primeiro</span>
                <Image src={sticker05} alt="Foguinho comemorando" width={46} densities={[1, 2]} class="sticker sticker--cheer" loading="lazy" />
              </div>
              <h3 data-diagnostico-titulo>Escolha uma opção acima.</h3>
              <p data-diagnostico-texto>A resposta aparece aqui.</p>
              <a class="text-link" href="#contato">Falar sobre isso <span aria-hidden="true">↓</span></a>
            </div>
          </div>
        </div>
      </section>
    </div>

    <div class="faq-section section-shell">
      <section id="perguntas" class="faq section-pad" aria-labelledby="titulo-perguntas">
        <div>
          <h2 id="titulo-perguntas" class="reveal">Dúvidas?<br /><em>Pode perguntar.</em></h2>
          <div class="faq__heading-sticker">
            <Image src={sticker05} alt="Foguinho pronto para responder" width={84} densities={[1, 2]} class="sticker sticker--cheer sticker--solto" loading="lazy" />
          </div>
        </div>
        <div class="faq__list">
          {perguntas.map(([pergunta, resposta], index) => (
            <details class="faq__item">
              <summary><span>{String(index + 1).padStart(2, '0')}</span>{pergunta}<i aria-hidden="true"></i></summary>
              <p>{resposta}</p>
            </details>
          ))}
        </div>
      </section>
    </div>

    <section id="contato" class="contact section-shell" aria-labelledby="titulo-contato">
      <div class="contact__flare" aria-hidden="true"></div>
      <div class="contact__inner">
        <div class="contact__copy">
          <h2 id="titulo-contato">Vamos conversar<br /><em>sobre o seu site?</em></h2>
          <p>Conte o que você precisa. A gente olha, recomenda o caminho e você decide com calma.</p>
          <form class="contact-form" action={formEndpoint || undefined} method="post" data-contact-form data-endpoint={formEndpoint}>
            <div class="contact-form__row">
              <label>
                <span>Seu nome</span>
                <input type="text" name="nome" autocomplete="name" placeholder="Como podemos chamar você?" required />
              </label>
              <label>
                <span>Seu e-mail</span>
                <input type="email" name="email" autocomplete="email" placeholder="voce@empresa.com" required />
              </label>
            </div>
            <label>
              <span>Empresa <i>opcional</i></span>
              <input type="text" name="empresa" autocomplete="organization" placeholder="Nome do negócio" />
            </label>
            <label>
              <span>O que você precisa?</span>
              <textarea name="mensagem" rows="4" placeholder="Conte um pouco sobre o site, o momento do negócio e o que ele precisa resolver." required></textarea>
            </label>
            <input class="contact-form__trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div class="contact-form__footer">
              <button class="button button--paper" type="submit">Enviar <ArrowIcon /></button>
              <p class="contact-form__status" aria-live="polite" data-contact-status>O envio será ativado assim que o e-mail da Foundry for definido.</p>
            </div>
          </form>
        </div>
        <div class="contact__mascot" data-slot="slot-cta-mascote">
          <Image src={mascote} alt="Foguinho, o mascote da Foundry" widths={[320, 520]} sizes="(min-width: 800px) 30vw, 52vw" loading="lazy" />
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    const reduzMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const progress = document.querySelector<HTMLElement>('[data-progress]');
    const diagnostico = document.querySelector<HTMLElement>('[data-diagnostico]');
    const formulario = document.querySelector<HTMLFormElement>('[data-contact-form]');

    // Uma atualização por quadro: o scroll dispara muito mais vezes do que a
    // tela consegue pintar.
    let quadroAgendado = false;
    const atualizarProgresso = () => {
      if (!progress || quadroAgendado) return;
      quadroAgendado = true;
      requestAnimationFrame(() => {
        quadroAgendado = false;
        const total = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.transform = `scaleX(${total > 0 ? window.scrollY / total : 0})`;
      });
    };

    if (!reduzMovimento) {
      const observer = new IntersectionObserver((entradas) => {
        entradas.forEach((entrada) => entrada.isIntersecting && entrada.target.classList.add('is-visible'));
      }, { threshold: 0.16 });
      document.querySelectorAll('.reveal, .reveal-item').forEach((elemento) => observer.observe(elemento));
      window.addEventListener('scroll', atualizarProgresso, { passive: true });
      atualizarProgresso();
    } else {
      document.querySelectorAll('.reveal, .reveal-item').forEach((elemento) => elemento.classList.add('is-visible'));
    }

    diagnostico?.querySelectorAll<HTMLButtonElement>('[data-diagnostico-opcao]').forEach((opcao) => {
      opcao.addEventListener('click', () => {
        diagnostico.querySelectorAll('[data-diagnostico-opcao]').forEach((item) => item.removeAttribute('data-selected'));
        opcao.setAttribute('data-selected', '');

        const nivel = opcao.dataset.nivel ?? '0';
        const medidor = diagnostico.querySelector<HTMLElement>('[data-diagnostico-nivel]');
        const valor = diagnostico.querySelector<HTMLElement>('[data-diagnostico-valor]');
        const titulo = diagnostico.querySelector<HTMLElement>('[data-diagnostico-titulo]');
        const texto = diagnostico.querySelector<HTMLElement>('[data-diagnostico-texto]');

        if (medidor) medidor.style.setProperty('--nivel', `${nivel}%`);
        if (valor) valor.textContent = `${nivel}%`;
        if (titulo) titulo.textContent = opcao.dataset.titulo ?? '';
        if (texto) texto.textContent = opcao.dataset.texto ?? '';
      });
    });

    formulario?.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      if (!formulario.reportValidity()) return;

      const endpoint = formulario.dataset.endpoint;
      const status = formulario.querySelector<HTMLElement>('[data-contact-status]');
      const botao = formulario.querySelector<HTMLButtonElement>('button[type="submit"]');

      if (!endpoint) {
        if (status) status.textContent = 'Formulário pronto. O envio será liberado quando o e-mail da Foundry for conectado.';
        formulario.dataset.state = 'pending';
        return;
      }

      formulario.dataset.state = 'sending';
      if (botao) botao.disabled = true;
      if (status) status.textContent = 'Enviando...';

      try {
        const resposta = await fetch(endpoint, {
          method: 'POST',
          body: new FormData(formulario),
          headers: { Accept: 'application/json' },
        });
        if (!resposta.ok) throw new Error('Falha no envio');

        formulario.reset();
        formulario.dataset.state = 'success';
        if (status) status.textContent = 'Recebido. A gente entra em contato em breve.';
      } catch {
        formulario.dataset.state = 'error';
        if (status) status.textContent = 'Não foi possível enviar. Tente de novo em alguns instantes.';
      } finally {
        if (botao) botao.disabled = false;
      }
    });
  </script>
</BaseLayout>
