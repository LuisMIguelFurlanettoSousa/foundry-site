---
import { Image } from 'astro:assets';
import ArrowIcon from '../components/ArrowIcon.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import analise from '../assets/clients/analise-ibraciv.webp';
import destiny from '../assets/clients/destiny-dao.webp';
import portfolio from '../assets/clients/portfolio.webp';
import supremus from '../assets/clients/supremus.webp';
import tokenbitz from '../assets/clients/tokenbitz.webp';
import sticker03 from '../assets/stickers/sticker-03.png';

const projetos = [
  { numero: '01', nome: 'Supremus — IBRACIV', tipo: 'Site · Mercado imobiliário', descricao: 'Página de um programa de mentoria, com depoimentos e um caminho claro até a inscrição.', imagem: supremus, url: 'https://supremus.ibraciv.com/' },
  { numero: '02', nome: 'Análise — IBRACIV', tipo: 'Ferramenta · Vendas', descricao: 'Ferramenta que faz perguntas ao corretor e devolve um resultado personalizado no fim.', imagem: analise, url: 'https://analise.ibraciv.com/' },
  { numero: '03', nome: 'TokenBitz', tipo: 'Site em vários idiomas', descricao: 'Site internacional em vários idiomas, ligado aos documentos e aos dados do projeto.', imagem: tokenbitz, url: 'https://tokenbitz.info/' },
  { numero: '04', nome: 'Destiny DAO — Docs', tipo: 'Documentação', descricao: 'Portal de documentação com menu lateral, gráficos e conteúdo em mais de dez idiomas.', imagem: destiny, url: 'https://doc.destinydao.org/' },
  { numero: '05', nome: 'Portfólio experimental', tipo: 'Projeto autoral', descricao: 'Site com vídeo, movimento e efeitos 3D, feito para testar ideias novas de interface.', imagem: portfolio, url: 'https://about-victor.netlify.app/' },
];
---

<BaseLayout title="Clientes e projetos | Foundry" description="Uma seleção de sites, ferramentas e automações já entregues pela Foundry.">
  <Header />
  <main id="conteudo">
    <section class="page-hero page-hero--clients section-shell" aria-labelledby="titulo-clientes">
      <div class="page-hero__content">
        <p class="eyebrow">Trabalhos selecionados</p>
        <h1 id="titulo-clientes">Projetos que já estão <em>no ar.</em></h1>
        <p>Sites, ferramentas e automações feitos para negócios bem diferentes entre si, sempre com cuidado.</p>
        <a class="text-link" href="#projetos">Ver os projetos <span aria-hidden="true">↓</span></a>
      </div>
      <div class="page-hero__index" aria-hidden="true"><span>06</span><small>projetos<br />entregues</small></div>
    </section>

    <div class="cases-section section-shell">
      <section id="projetos" class="cases section-pad" aria-labelledby="titulo-projetos">
        <div class="cases__heading">
          <div class="cases__heading-top">
            <Image src={sticker03} alt="Foguinho aprovando com o polegar" width={84} densities={[1, 2]} class="sticker sticker--thumb sticker--solto" loading="lazy" />
          </div>
          <h2 id="titulo-projetos">Cada projeto pede<br /><em>uma solução diferente.</em></h2>
        </div>

      <div class="case-grid">
        {projetos.map((projeto) => (
          <article class="case-card">
            <a href={projeto.url} target="_blank" rel="noreferrer" aria-label={`Visitar ${projeto.nome}`}>
              <div class="case-card__media"><Image src={projeto.imagem} alt={`Tela do projeto ${projeto.nome}`} widths={[520, 900]} sizes="(min-width: 900px) 48vw, 100vw" loading="lazy" /></div>
              <div class="case-card__copy">
                <div><span>{projeto.numero}</span><span>{projeto.tipo}</span></div>
                <h3>{projeto.nome}</h3>
                <p>{projeto.descricao}</p>
                <span class="text-link">Visitar projeto <b aria-hidden="true">↗</b></span>
              </div>
            </a>
          </article>
        ))}

        <article class="case-card case-card--agent">
          <div class="case-card__agent-visual" aria-hidden="true"><span>IA</span><i>24/7</i><b>Telegram</b></div>
          <div class="case-card__copy">
            <div><span>06</span><span>Automação · Inteligência artificial</span></div>
            <h3>Bot de IA para Telegram</h3>
            <p>Atendente ligado a modelos de inteligência artificial, com filtros, controle anti-spam e painel para acompanhar tudo.</p>
            <span class="case-card__private">Projeto sem endereço público</span>
          </div>
        </article>
      </div>
    </section>
    </div>

    <section class="page-cta section-shell" aria-labelledby="titulo-cta-clientes">
      <h2 id="titulo-cta-clientes">Quer ser o próximo?<br /><em>Vamos conversar.</em></h2>
      <p>Conte a sua situação. A gente indica o primeiro passo e monta a solução.</p>
      <a class="button button--paper" href="/#contato">Começar um projeto <ArrowIcon /></a>
    </section>
  </main>
  <Footer />
</BaseLayout>
